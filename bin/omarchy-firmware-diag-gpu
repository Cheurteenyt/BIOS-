#!/usr/bin/env python3
# omarchy:summary=GPU health audit (Xid history, thermal slowdown, BAR1, PCIe link) — T0 read-only
# omarchy:args=[--json] [--fixture-dir DIR]
# omarchy:examples=omarchy firmware diag gpu --json | omarchy firmware diag gpu

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _cand in (os.path.join(os.path.dirname(_here), "lib"),  # repo checkout
              os.path.expanduser(  # install.sh layout (P5)
                  "~/.local/share/omarchy-firmware/lib")):
    if os.path.isdir(_cand):
        sys.path.insert(0, _cand)
        break
from firmware_hal.cli import main  # noqa: E402

args = sys.argv[1:]
if not args:
    args = ["diag", "gpu"]
elif args[0].startswith("-"):
    args = ["diag", "gpu"] + args
sys.exit(main(args))
