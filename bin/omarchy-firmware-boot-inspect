#!/usr/bin/env python3
# omarchy:summary=Inspect the boot chain: efibootmgr entries, UKI/Limine, Snapper snapshots
# omarchy:args=[--json]
# omarchy:examples=omarchy firmware boot inspect

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_xdg = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
for _cand in (os.path.join(os.path.dirname(_here), "lib"),  # repo checkout
              os.path.join(_xdg,  # install.sh layout (P5), XDG_DATA_HOME-aware
                           "omarchy-firmware", "lib")):
    if os.path.isdir(_cand):
        sys.path.insert(0, _cand)
        break
from firmware_hal.cli import main  # noqa: E402

sys.exit(main(["boot", "inspect", *sys.argv[1:]]))
