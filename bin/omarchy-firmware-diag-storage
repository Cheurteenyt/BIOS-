#!/usr/bin/env python3
# omarchy:summary=Storage health audit (NVMe/SATA SMART, PCIe links) — T0 read-only
# omarchy:args=[--json] [--fixture-dir DIR]
# omarchy:examples=omarchy firmware diag storage --json | omarchy firmware diag storage

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from firmware_hal.cli import main  # noqa: E402

args = sys.argv[1:]
if not args:
    args = ["diag", "storage"]
elif args[0].startswith("-"):
    args = ["diag", "storage"] + args
sys.exit(main(args))
