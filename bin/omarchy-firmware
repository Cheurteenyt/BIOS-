#!/usr/bin/env python3
# omarchy:summary=Dispatcher of the omarchy-firmware group (audit, boot, update, journal, mcp)
# omarchy:args=<audit|boot|update|journal|tiers|selftest|mcp> [options]
# omarchy:examples=omarchy firmware audit status | omarchy firmware boot inspect | omarchy firmware selftest

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_xdg = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
for _cand in (os.path.join(os.path.dirname(_here), "lib"),  # repo checkout
              os.path.join(_xdg,  # install.sh layout (P5), XDG_DATA_HOME-aware
                           "omarchy-firmware", "lib")):
    if os.path.isdir(_cand):
        sys.path.insert(0, _cand)
        break
from firmware_hal.cli import main  # noqa: E402

if len(sys.argv) == 1:
    sys.argv.append("tiers")  # bare: display the contract rather than a bare error
sys.exit(main(sys.argv[1:]))
