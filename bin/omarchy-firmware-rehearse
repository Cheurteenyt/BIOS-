#!/usr/bin/env python3
# omarchy:summary=The dress rehearsal — the whole behavioural contract of omarchy-firmware in one command
# omarchy:args=[--backend twin|real] [--json] [--no-report]
# omarchy:examples=omarchy firmware rehearse --backend twin | omarchy firmware rehearse (day-0, on the machine)

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _cand in (os.path.join(os.path.dirname(_here), "lib"),  # repo checkout
              os.path.expanduser(  # install.sh layout (P5)
                  "~/.local/share/omarchy-firmware/lib")):
    if os.path.isdir(_cand):
        sys.path.insert(0, _cand)
        break

from firmware_hal.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(["rehearse"] + sys.argv[1:]))
