#!/usr/bin/env python3
# omarchy:summary=Check local fwupd firmware updates (15 min cache, no network unless asked)
# omarchy:args=[--json] [--refresh]
# omarchy:examples=omarchy firmware update check | omarchy firmware update check --refresh

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _cand in (os.path.join(os.path.dirname(_here), "lib"),  # repo checkout
              os.path.expanduser(  # install.sh layout (P5)
                  "~/.local/share/omarchy-firmware/lib")):
    if os.path.isdir(_cand):
        sys.path.insert(0, _cand)
        break
from firmware_hal.cli import main  # noqa: E402

sys.exit(main(["update", "check", *sys.argv[1:]]))
