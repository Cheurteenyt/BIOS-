 "reading": {
  "root_cause": "the 32-MiB part carries TWO complete 16-MiB firmware builds in two SPI address windows, each self-contained (boot FV, main DXE FV, data FV, NVRAM, PSP chain) and each covering a DISJOINT SET of CPU families; per-family routing is AMD's documented combo architecture (PSP2/BHD2 level-2 directories, doc #55758): the combo entries carry per-chip PSP IDs and resolve to per-family $PSP/$BHD directories",
  "dissolves": [
   "ring 13's '+16 files / +0x97000 B mirror' \u2014 the upper window's DXE covers more families, not a clone",
   "ring 13's '2PSP at the mirror of the primary $PSP' \u2014 the PSP2 combo cookie at the upper window's fixed location (0xa8000 within-window)",
   "ring 13's 'ten directories validate only in the upper half' \u2014 the upper families' own directories",
   "ring 14's 'NVRAM not a clone' \u2014 each window's firmware ships its own Setup defaults (the upper's Setup DB is +195,872 B: more options for newer families)"
  ]
 },
 "honesty": {
  "psp_id_semantics": "the combo entry IDs (0xbc09/0x0a/0x0b/0x0c ranges) are measured and stable but no public table maps them to family names; family routing is inferred from the window contents (module names), flagged as inference",
  "boot_window": "which window the hardware selects at reset is not measurable from the file (strap/register side); both windows are complete and bootable (each owns the reset vector inside its own data FV)",
  "combo_address_conventions": "lower-window combo addresses are 0xFF-based absolute; upper-window are window-relative \u2014 both resolve, fletcher-validated",
  "no_flash": "read-only forensics; nothing executed, nothing written"
 }
